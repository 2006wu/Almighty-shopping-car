FROM ros:humble-ros-base
ARG ROS_APT_MIRROR=
COPY docker/configure-ros-mirror.py /usr/local/bin/configure-ros-mirror.py
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:99 LIBGL_ALWAYS_SOFTWARE=1 QT_X11_NO_MITSHM=1
RUN python3 /usr/local/bin/configure-ros-mirror.py "$ROS_APT_MIRROR" \
    && apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rviz2 ros-humble-nav2-rviz-plugins ros-humble-rviz-default-plugins \
    ros-humble-rmw-fastrtps-cpp ros-humble-ros-gz-sim \
    xvfb openbox x11vnc novnc websockify x11-utils \
    libgl1-mesa-dri libglx-mesa0 mesa-utils netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
COPY docker/display-entrypoint /usr/local/bin/display-entrypoint
COPY docker/compute-entrypoint /usr/local/bin/compute-entrypoint
RUN chmod +x /usr/local/bin/display-entrypoint /usr/local/bin/compute-entrypoint
WORKDIR /ws
ENTRYPOINT ["/usr/local/bin/display-entrypoint"]
