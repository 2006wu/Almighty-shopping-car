#!/usr/bin/env bash
set -eo pipefail
source /opt/ros/humble/setup.bash
if [[ -f /ws/install/setup.bash ]]; then source /ws/install/setup.bash; fi
set -u
export DISPLAY=:99
export LIBGL_ALWAYS_SOFTWARE=1
: "${VNC_PASSWORD:?VNC_PASSWORD is required}"
pids=()
cleanup() { kill "${pids[@]}" 2>/dev/null || true; }
trap cleanup EXIT
trap 'exit 0' TERM INT
Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp >/tmp/xvfb.log 2>&1 &
pids+=("$!")
ready=false
for _ in {1..40}; do
  if xdpyinfo -display :99 >/dev/null 2>&1; then ready=true; break; fi
  sleep 0.25
done
[[ "$ready" == true ]]
openbox >/tmp/openbox.log 2>&1 &
pids+=("$!")
x11vnc -storepasswd "$VNC_PASSWORD" /tmp/vnc.pass >/dev/null 2>&1
chmod 600 /tmp/vnc.pass
x11vnc -display :99 -rfbport 5900 -listen 0.0.0.0 -forever -shared -rfbauth /tmp/vnc.pass >/tmp/x11vnc.log 2>&1 &
pids+=("$!")
websockify --web=/usr/share/novnc 6080 127.0.0.1:5900 >/tmp/novnc.log 2>&1 &
pids+=("$!")
if [[ "${AUTOSTART_RVIZ:-0}" == 1 ]]; then
  ros2 launch shopping_robot_bringup rviz.launch.py >/tmp/rviz.log 2>&1 &
  pids+=("$!")
fi
wait -n "${pids[@]}"
exit 1
