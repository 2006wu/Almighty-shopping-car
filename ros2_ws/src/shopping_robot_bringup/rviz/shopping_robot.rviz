Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 19; 28; 40
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric grid
      Enabled: true
      Reference Frame: map
      Plane Cell Count: 24
      Cell Size: 1
      Color: 70; 90; 110
      Alpha: 0.25
      Line Style: {Value: Lines, Line Width: 0.01}
    - Class: rviz_default_plugins/Map
      Name: Occupancy map
      Enabled: true
      Topic: {Value: /map, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.85
      Draw Behind: true
    - Class: rviz_default_plugins/RobotModel
      Name: Shopping robot
      Enabled: true
      Description Source: Topic
      Description Topic: {Value: /robot_description, Durability Policy: Transient Local}
    - Class: rviz_default_plugins/LaserScan
      Name: Laser returns
      Enabled: true
      Topic: {Value: /scan, Reliability Policy: Best Effort}
      Color Transformer: FlatColor
      Color: 255; 174; 86
      Style: Flat Squares
      Size (m): 0.025
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Global route
      Enabled: true
      Topic: {Value: /plan, Reliability Policy: Reliable}
      Color: 60; 218; 230
      Line Style: Billboards
      Line Width: 0.045
      Pose Style: None
      Offset: {X: 0, Y: 0, Z: 0.04}
    - Class: rviz_default_plugins/Polygon
      Name: Robot footprint
      Enabled: true
      Topic: {Value: /local_costmap/published_footprint, Reliability Policy: Reliable}
      Color: 126; 226; 184
      Alpha: 0.9
    - Class: rviz_default_plugins/MarkerArray
      Name: Shopping zones
      Enabled: true
      Topic: {Value: /shopping/zone_markers, Durability Policy: Transient Local}
    - Class: rviz_default_plugins/MarkerArray
      Name: UWB person target
      Enabled: true
      Topic: {Value: /uwb/markers}
    - Class: rviz_common/Group
      Name: Optional diagnostics
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/TF
          Name: Coordinate frames
          Enabled: false
          Show Names: false
          Marker Scale: 0.3
        - Class: rviz_default_plugins/Path
          Name: Fast TEB trajectory
          Enabled: false
          Topic: {Value: /Fast/teb_path, Reliability Policy: Reliable}
          Color: 238; 158; 228
          Line Style: Billboards
          Line Width: 0.035
          Pose Style: None
        - Class: rviz_default_plugins/Path
          Name: Slow TEB trajectory
          Enabled: false
          Topic: {Value: /Slow/teb_path, Reliability Policy: Reliable}
          Color: 162; 164; 255
          Line Style: Billboards
          Line Width: 0.035
          Pose Style: None
        - Class: rviz_default_plugins/Map
          Name: Local safety costmap
          Enabled: false
          Topic: {Value: /local_costmap/costmap, Durability Policy: Transient Local, Reliability Policy: Reliable}
          Color Scheme: costmap
          Alpha: 0.35
  Tools:
    - {Class: rviz_default_plugins/Interact}
    - {Class: rviz_default_plugins/MoveCamera}
    - {Class: rviz_default_plugins/Select}
    - {Class: rviz_default_plugins/Measure}
    - {Class: rviz_default_plugins/SetInitialPose}
    - {Class: nav2_rviz_plugins/GoalTool}
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Store overview
      Target Frame: map
      Scale: 80
      X: 0
      Y: 2
      Angle: 0
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Robot perspective
        Target Frame: base_footprint
        Distance: 7
        Pitch: 0.9
        Yaw: 0.8
        Focal Point: {X: 0, Y: 0, Z: 0}
  Enabled: true
Window Geometry: {Width: 1920, Height: 1040, X: 0, Y: 0}
