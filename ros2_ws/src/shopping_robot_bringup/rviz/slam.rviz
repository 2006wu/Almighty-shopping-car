Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 10
    Background Color: 19; 28; 40
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 30
      Cell Size: 1
      Color: 70; 90; 110
      Alpha: 0.25
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic: {Value: /map, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Alpha: 0.85
    - Class: rviz_default_plugins/MarkerArray
      Name: SLAM Pose Graph
      Enabled: false
      Topic: {Value: /slam_toolbox/graph_visualization, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic: {Value: /robot_description, Durability Policy: Transient Local}
    - Class: rviz_default_plugins/LaserScan
      Name: Laser
      Enabled: true
      Topic: {Value: /scan, Reliability Policy: Best Effort}
      Color: 255; 174; 86
      Size (m): 0.025
      Color Transformer: FlatColor
      Style: Flat Squares
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic: {Value: /plan, Reliability Policy: Reliable}
      Color: 60; 218; 230
      Line Style: Billboards
      Line Width: 0.04
  Tools:
    - {Class: rviz_default_plugins/Interact}
    - {Class: rviz_default_plugins/MoveCamera}
    - {Class: rviz_default_plugins/Measure}
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 80
      X: 0
      Y: 2
      Angle: 0
Window Geometry: {Width: 1920, Height: 1040, X: 0, Y: 0}
