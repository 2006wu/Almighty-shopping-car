<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="shopping_robot">
  <xacro:property name="length" value="0.60"/>
  <xacro:property name="width" value="0.50"/>
  <xacro:property name="height" value="0.18"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="skid_track_factor" value="2.0"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:arg name="anchor_count" default="3"/>
  <xacro:property name="anchor_0_x" value="0.0"/><xacro:property name="anchor_0_y" value="0.22"/>
  <xacro:property name="anchor_1_x" value="0.0"/><xacro:property name="anchor_1_y" value="-0.22"/>
  <xacro:property name="anchor_2_x" value="-0.25"/><xacro:property name="anchor_2_y" value="0.0"/>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.20"/></joint>
  <link name="base_link">
    <inertial><mass value="20"/><inertia ixx="${20*(width*width+height*height)/12}" iyy="${20*(length*length+height*height)/12}" izz="${20*(length*length+width*width)/12}" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="${length} ${width-2*wheel_width} ${height}"/></geometry><material name="blue"><color rgba="0.1 0.4 0.8 1"/></material></visual>
    <collision><geometry><box size="${length} ${width-2*wheel_width} ${height}"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <inertial><mass value="0.6"/><inertia ixx="0.00158" iyy="0.003" izz="0.00158" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="continuous"><parent link="base_link"/><child link="${name}_wheel"/><origin xyz="${x} ${y} -0.10"/><axis xyz="0 1 0"/><limit effort="20" velocity="15"/><dynamics damping="0.05"/></joint>
    <gazebo reference="${name}_wheel"><mu1>0.5</mu1><mu2>0.5</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel name="front_left" x="${length*0.33}" y="${(width-wheel_width)/2}"/>
  <xacro:wheel name="rear_left" x="${-length*0.33}" y="${(width-wheel_width)/2}"/>
  <xacro:wheel name="front_right" x="${length*0.33}" y="${-(width-wheel_width)/2}"/>
  <xacro:wheel name="rear_right" x="${-length*0.33}" y="${-(width-wheel_width)/2}"/>
  <xacro:macro name="frame" params="name x y z">
    <link name="${name}"/>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} ${z}"/></joint>
  </xacro:macro>
  <xacro:frame name="laser_link" x="0.18" y="0" z="0.16"/>
  <xacro:frame name="imu_link" x="0" y="0" z="0.05"/>
  <xacro:frame name="uwb_anchor_0" x="${anchor_0_x}" y="${anchor_0_y}" z="0.12"/>
  <xacro:frame name="uwb_anchor_1" x="${anchor_1_x}" y="${anchor_1_y}" z="0.12"/>
  <xacro:if value="${int('$(arg anchor_count)') == 3}"><xacro:frame name="uwb_anchor_2" x="${anchor_2_x}" y="${anchor_2_y}" z="0.12"/></xacro:if>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar"><always_on>true</always_on><update_rate>10</update_rate><topic>scan</topic><ignition_frame_id>laser_link</ignition_frame_id>
      <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan><range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range></lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link"><sensor name="imu" type="imu"><always_on>true</always_on><update_rate>50</update_rate><topic>imu</topic><ignition_frame_id>imu_link</ignition_frame_id></sensor></gazebo>
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint><left_joint>rear_left_joint</left_joint><right_joint>front_right_joint</right_joint><right_joint>rear_right_joint</right_joint>
      <!-- Effective track for skid steer: lateral wheel scrub resists yaw, so the geometric track (~0.44 m)
         barely turns the base at small angular commands. skid_track_factor scales it (calibrate on the real base). -->
      <wheel_separation>${(width-wheel_width)*skid_track_factor}</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic><odom_topic>wheel_odom</odom_topic><tf_topic>wheel_tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity><max_angular_velocity>1.2</max_angular_velocity>
    </plugin>
    <!-- Skid-steer wheel odometry from DiffDrive drifts badly in yaw (lateral wheel slip), so /odom and odom->base_footprint
         come from the simulator pose (OdometryPublisher). Wheel odometry is still bridged on /wheel_odom for comparison;
         realistic odometry noise and an IMU/wheel EKF are planned in docs/ROADMAP.md. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame><robot_base_frame>base_footprint</robot_base_frame><odom_topic>odom</odom_topic><tf_topic>tf</tf_topic>
      <dimensions>2</dimensions><odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"><topic>joint_states</topic></plugin>
  </gazebo>
</robot>
