<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <StopController>
      <!-- <SetupUpdater> -->
      <ResetRecovery current_child_idx="{current_child_idx}">
        <RecoveryNode number_of_retries="3" name="NavigateRecovery">
          <RetryUntilSuccessful num_attempts="3">
            <PipelineSequence name="NavigateWithReplanning">
              <RateController hz="5">
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              </RateController>
              <Sequence>
                  <ControllerSelector topic_name="/controller_type" default_controller="Fast" selected_controller="{controller}"/>
                  <GoalCheckerSelector topic_name="/goal_checker_type" default_goal_checker="Loose" selected_goal_checker="{goal_checker}"/>
                  <FollowPath path="{path}" controller_id="{controller}" goal_checker_id="{goal_checker}"/>
              </Sequence>
            </PipelineSequence>
          </RetryUntilSuccessful>
          <ReactiveFallback name="RecoveryFallback">
            <GoalUpdated/>
            <Sequence>
              <Shrink shrink_to="0.45"/>
              <Wait wait_duration="0.5"/>
            </Sequence>
          </ReactiveFallback>
        </RecoveryNode>
      </ResetRecovery>
      <!-- </SetupUpdater> -->
    </StopController>
  </BehaviorTree>
</root>
